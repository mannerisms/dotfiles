# Ghostty config, mirroring the old Alacritty setup (font, padding, translucency, Nordic colours)

font-family = "Hack Nerd Font"
font-size = 12

window-padding-x = 5
window-padding-y = 0

# No title bar (tmux and AeroSpace handle tabs and splits; macOS native tabs are off with this)
macos-titlebar-style = hidden

background-opacity = 0.80
background-blur = true

# Shift+Enter sends ESC + Return (newline in Claude Code and similar TUIs), same as the Alacritty binding
keybind = shift+enter=text:\x1b\r

# Over SSH, fall back to TERM=xterm-256color on hosts that do not know xterm-ghostty (NAS, Proxmox, ...)
shell-integration-features = ssh-env

# Nordic palette (vendored from alacritty-theme)
background = 242933
foreground = BBBDAF
selection-background = F0DFAF
selection-foreground = 000000
palette = 0=#191C1D
palette = 1=#BD6062
palette = 2=#A3D6A9
palette = 3=#F0DFAF
palette = 4=#8FB4D8
